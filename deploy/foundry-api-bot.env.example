# Copy to /etc/foundry-api-bot/env and edit the first values.
FOUNDRY_URL=http://127.0.0.1:30000
FOUNDRY_USER=api-bot
FOUNDRY_PASSWORD=change-me
CHECK_MODULE_ID=foundryvtt-rest-api

# Optional relay verification.
REST_RELAY_URL=
REST_RELAY_API_KEY=
REST_RELAY_CLIENT_ID=

# systemd state paths. Keep these under /var/lib/foundry-api-bot.
USER_DATA_DIR=/var/lib/foundry-api-bot/browser-profile
STATUS_FILE=/var/lib/foundry-api-bot/status.json
ARTIFACTS_DIR=/var/lib/foundry-api-bot/artifacts
HEADLESS=true
