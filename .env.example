# Tip: run `npm run setup` to generate this file interactively instead of
# editing it by hand. `npm start` also offers setup on first run.

# Required: Foundry and bot login.
FOUNDRY_URL=http://127.0.0.1:30000
FOUNDRY_USER=api-bot
FOUNDRY_PASSWORD=change-me

# Recommended: verify that the Foundry REST module is active after login.
CHECK_MODULE_ID=foundryvtt-rest-api

# Optional but useful: verify the REST relay sees at least one connected client.
# Use the HTTP(S) relay base URL, not the module's ws:// or wss:// URL.
REST_RELAY_URL=
REST_RELAY_API_KEY=
REST_RELAY_CLIENT_ID=

# Advanced options. The defaults below are fine for most servers.
HEADLESS=true
USER_DATA_DIR=./data/browser-profile
STATUS_FILE=./data/status.json
ARTIFACTS_DIR=./artifacts
CHECK_INTERVAL_SECONDS=30
RELOAD_AFTER_FAILURES=3
# Consecutive relay-only failures before nudging the websocket with one reload.
# Defaults to RELOAD_AFTER_FAILURES x 3. A relay outage never reloads Foundry on its own.
RELAY_RELOAD_AFTER_FAILURES=9
# Cleanly recycle the browser every N hours to avoid slow memory growth. 0 disables.
RESTART_AFTER_HOURS=24
WORLD_READY_TIMEOUT_SECONDS=120
LOGIN_TIMEOUT_SECONDS=60
NAVIGATION_TIMEOUT_SECONDS=60
STATUS_PROBE_TIMEOUT_SECONDS=10
REST_RELAY_TIMEOUT_SECONDS=10
IGNORE_HTTPS_ERRORS=false
CHROMIUM_NO_SANDBOX=false
REQUIRE_GM=true
USE_EXISTING_BROWSER_SESSION=false
ALLOW_EMPTY_PASSWORD=false
